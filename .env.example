# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Optional: set this to the path of a persistent disk/volume on your host.
# Leave unset to use ./data/db.json.
# MYGAIN_DATA_DIR=/var/lib/mygain

# Used only when the database has no admin account yet.
# Do NOT commit real values to source control.
MYGAIN_ADMIN_EMAIL=admin@example.com
MYGAIN_ADMIN_PASSWORD=replace-with-a-strong-unique-password
